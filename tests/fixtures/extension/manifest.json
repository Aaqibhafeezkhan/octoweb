{
  "manifest_version": 3,
  "name": "Octoweb Test Extension",
  "version": "1.0",
  "description": "Fixture for test_mcp.py --extensions: content script, messaging, storage, tabs, toolbar action and context menu.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "permissions": ["storage", "tabs", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": { "default_title": "Octoweb Test", "default_popup": "popup.html" },
  "options_page": "popup.html",
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "MacCtrl+Shift+Y" } }
  }
}
